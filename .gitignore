
# Ignore
# No trailing slash: also catches a node_modules path that happens to be
# a symlink or regular file (a stray symlink slipped past `node_modules/`
# once and got committed — every mentat git pull then re-materialized a
# broken self-referencing link). Same reasoning as score-relay below.
node_modules
scratch/
/storage/
data/
*.un~
.*.un~

client/
scratch/

# only ignore the cache at the root level
/cache/

# Playwright
e2e/.auth/
playwright-report/
test-results/

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# tsc
*.tsbuildinfo

# CodeRush
.cr/

# test
coverage
/storage/

# eslint
.eslintcache

# General
.DS_Store
.AppleDouble
.LSOverride

# Local
.env
# Backups the deploy/env tooling leaves behind (.env.bak-YYYYMMDD-HHMM). Untracked
# and unignored, one of these silently blocked `bump-factory-consumers.sh` — its
# preflight aborts the WHOLE ecosystem fan-out on any repo with a dirty tree, and a
# stray env backup counts.
.env.bak*
.env.save
.env.orig
dist
build
.webpack

# Storybook
storybook-static/

# Admin client build output
admin-client/dist/
admin-client/node_modules

# Staged by mentat-push-server.sh during deploy.
# On mentat-dev, this is a symlink to ../epixodic/score-relay so that
# ecosystem.config.js's relative `score-relay/dist/server.js` path
# resolves locally without duplicating node_modules. Pattern with no
# trailing slash matches both the directory (on nest) and the symlink
# (on mentat).
score-relay
# Runtime locale cache lives at the project-root i18n/ — anchor with the
# leading slash so it doesn't also swallow src/modules/i18n/.
/i18n/

# Local fallback for provider archives (provider-archive.service.ts) when
# ARCHIVES_PATH is unset — dev/CI dumps deleted-provider data here (e.g.
# throwaway E2E providers). Never commit these local dumps.
.archives-local/

# Per-session Claude Code state: `settings.local.json` is personal and
# `.claude/worktrees/` holds git worktrees (architectural standard A8), so this
# directory is tooling, never source. Untracked it shows as a permanent pending
# change in every `git status` — and it is not merely cosmetic: a dirty repo
# aborts the whole `bump-factory-consumers.sh` fan-out at preflight.
.claude
